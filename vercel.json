{
  "rewrites": [
    {
      "source": "/voyage/:token",
      "destination": "/index.html"
    },
    {
      "source": "/voyageur/:pseudo",
      "destination": "/index.html"
    },
    {
      "source": "/admin-stats",
      "destination": "/index.html"
    },
    {
      "source": "/admin-stats/",
      "destination": "/index.html"
    },
    {
      "source": "/mentions-legales",
      "destination": "/mentions-legales.html"
    },
    {
      "source": "/confidentialite",
      "destination": "/confidentialite.html"
    },
    {
      "source": "/conditions",
      "destination": "/conditions.html"
    },
    {
      "source": "/cookies",
      "destination": "/cookies.html"
    }
  ],
  "headers": [
    {
      "source": "/voyage/:token",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/voyageur/:pseudo",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin-stats",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin-stats/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
